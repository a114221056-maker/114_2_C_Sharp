using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using System.IO;
using System.Diagnostics;

namespace CSV_Reader
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void getScoresButton_Click(object sender, EventArgs e)
        {
            // 嘗試讀取名為 "Grade.csv" 的 CSV 檔案，計算每位學生三科成績的平均並顯示於清單
            try
            {
                using (StreamReader inputFile = File.OpenText("Grade.csv"))
                {
                    char[] delim = { ',' };
                    string line;

                    while ((line = inputFile.ReadLine()) != null)
                    {
                        // 以逗號分割欄位
                        string[] fields = line.Split(delim);

                        // 檢查欄位數量是否足夠（姓名 + 3 個成績）
                        if (fields.Length >= 4)
                        {
                            double s1, s2, s3;
                            // 嘗試解析三個成績欄位，若解析成功則計算平均
                            if (double.TryParse(fields[1], out s1) &&
                                double.TryParse(fields[2], out s2) &&
                                double.TryParse(fields[3], out s3))
                            {
                                double average = (s1 + s2 + s3) / 3.0;
                                this.averagesListBox.Items.Add($"{fields[0]} 的平均分數為 {average:F2}");
                            }
                            else
                            {
                                // 若成績格式有誤，將訊息加入清單以便使用者檢查
                                this.averagesListBox.Items.Add($"{fields[0]} 的成績格式錯誤，無法計算平均值");
                            }
                        }
                        else
                        {
                            // 欄位不足，記錄於清單
                            this.averagesListBox.Items.Add("資料格式錯誤：欄位不足 - " + line);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                // 顯示繁體中文錯誤訊息
                MessageBox.Show("發生錯誤：" + ex.Message);
            }
        }

        // 結束按鈕事件：關閉表單
        private void exitButton_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
