using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using System.IO;

namespace CSV_Reader
{
    // 顏色光譜列舉型別：示範如何加入 enum，包含常見的七色
    public enum Spectrum
    {
        Red,
        Orange,
        Yellow,
        Green,
        Blue,
        Indigo,
        Violet
    }

    // 與範例一致的 Student 結構（欄位：Class, Id, Name, scores）
    public struct Student
    {
        public string Class;
        public string Id;
        public string Name;
        public int[] scores;
    }

    public partial class Form1 : Form
    {
        // 儲存所有學生記錄
        private List<Student> gradeBook = new List<Student>();

        /// <summary>
        /// CSV 讀取器應用程式的建構函式
        /// </summary>
        public Form1()
        {
            InitializeComponent();
        }

        /// <summary>
        /// 「取得分數」按鈕的點擊事件處理函式
        /// 讀取 "Grades.csv"（假設 UTF-8），每列格式：系別,學號,姓名,分數1,分數2,...
        /// </summary>
        private void getScoresButton_Click(object sender, EventArgs e)
        {
            // 清除顯示與 gradeBook
            this.averagesListBox.Items.Clear();
            gradeBook.Clear();

            try
            {
                // 使用 UTF8 編碼開啟檔案
                using (StreamReader reader = new StreamReader("Grades.csv", Encoding.UTF8))
                {
                    string line;
                    char[] delim = { ',' };

                    while ((line = reader.ReadLine()) != null)
                    {
                        if (string.IsNullOrWhiteSpace(line))
                            continue;

                        string[] fields = line.Split(delim);

                        // 需至少包含 班級,學號,姓名,分數1
                        if (fields.Length < 4)
                        {
                            this.averagesListBox.Items.Add("資料格式錯誤：欄位不足 - " + line);
                            continue;
                        }

                        Student s = new Student();
                        s.Class = fields[0].Trim();
                        s.Id = fields[1].Trim();
                        s.Name = fields[2].Trim();

                        int scoreCount = fields.Length - 3;
                        s.scores = new int[scoreCount];

                        for (int i = 0; i < scoreCount; i++)
                        {
                            int v;
                            if (int.TryParse(fields[i + 3].Trim(), out v))
                            {
                                s.scores[i] = v;
                            }
                            else
                            {
                                // 無法解析則視為 0
                                s.scores[i] = 0;
                            }
                        }

                        gradeBook.Add(s);
                    }
                }

                // 計算並顯示每位學生平均與全班平均
                double totalOfAverages = 0.0;
                int counted = 0;

                foreach (var st in gradeBook)
                {
                    if (st.scores != null && st.scores.Length > 0)
                    {
                        double sum = 0;
                        for (int i = 0; i < st.scores.Length; i++) sum += st.scores[i];
                        double avg = sum / st.scores.Length;

                        this.averagesListBox.Items.Add($"{st.Name} ({st.Id}) 的平均分數為 {avg:F2}");
                        totalOfAverages += avg;
                        counted++;
                    }
                    else
                    {
                        this.averagesListBox.Items.Add($"{st.Name} ({st.Id}) 無可計算的成績欄位");
                    }
                }

                if (counted > 0)
                {
                    double classAvg = totalOfAverages / counted;
                    this.averagesListBox.Items.Add("---------------------------");
                    this.averagesListBox.Items.Add($"全班平均分數為 {classAvg:F2} (基於 {counted} 位有成績的學生)");
                }
                else
                {
                    this.averagesListBox.Items.Add("沒有可計算平均值的學生成績。");
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("發生錯誤：" + ex.Message);
            }
        }

        /// <summary>
        /// 結束按鈕：關閉表單
        /// </summary>
        private void exitButton_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
