using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using System.IO;
using System.Diagnostics;

namespace CSV_Reader
{
    // 定義學生資料結構：包含班級、學號、姓名與任意數量的成績
    public struct Student
    {
        public string ClassName;
        public string StudentId;
        public string StudentName;
        public List<double> Scores;

        // 計算學生平均（若無成績回傳 0）
        public double Average
        {
            get
            {
                if (Scores == null || Scores.Count == 0) return 0.0;
                return Scores.Average();
            }
        }
    }

    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void getScoresButton_Click(object sender, EventArgs e)
        {
            // 清除舊資料，準備顯示新的平均數
            this.averagesListBox.Items.Clear();

            // 嘗試讀取名為 "Grade.csv" 的 CSV 檔案，將每列轉成 Student 結構並計算平均
            try
            {
                List<Student> students = new List<Student>();

                using (StreamReader inputFile = File.OpenText("Grade.csv"))
                {
                    char[] delim = { ',' };
                    string line;

                    while ((line = inputFile.ReadLine()) != null)
                    {
                        string[] fields = line.Split(delim);

                        // 若欄位數太少則跳過
                        if (fields.Length < 4) continue; // 需至少有 班級,學號,姓名,分數1

                        Student s = new Student();
                        s.ClassName = fields[0];
                        s.StudentId = fields[1];
                        s.StudentName = fields[2];
                        s.Scores = new List<double>();

                        // 從第4欄開始為成績欄位，可支援任意科數
                        for (int i = 3; i < fields.Length; i++)
                        {
                            double v;
                            if (double.TryParse(fields[i], out v))
                            {
                                s.Scores.Add(v);
                            }
                        }

                        students.Add(s);
                    }
                }

                // 顯示每位學生的平均並計算全班平均
                double totalOfAverages = 0.0;
                int counted = 0;

                foreach (var st in students)
                {
                    if (st.Scores != null && st.Scores.Count > 0)
                    {
                        double avg = st.Average;
                        this.averagesListBox.Items.Add($"{st.StudentName} ({st.StudentId}) 的平均分數為 {avg:F2}");
                        totalOfAverages += avg;
                        counted++;
                    }
                    else
                    {
                        this.averagesListBox.Items.Add($"{st.StudentName} ({st.StudentId}) 無可計算的成績欄位");
                    }
                }

                if (counted > 0)
                {
                    double classAvg = totalOfAverages / counted;
                    this.averagesListBox.Items.Add("---------------------------");
                    this.averagesListBox.Items.Add($"全班平均分數為 {classAvg:F2} (基於 {counted} 位有成績的學生)");
                }
                else
                {
                    this.averagesListBox.Items.Add("沒有可計算平均值的學生成績。");
                }
            }
            catch (Exception ex)
            {
                // 顯示繁體中文錯誤訊息
                MessageBox.Show("發生錯誤：" + ex.Message);
            }
        }

        // 結束按鈕事件：關閉表單
        private void exitButton_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
