using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Account_Simulator
{
    class BankAccount
    {
       private decimal balance;
        // 以屬性公開目前餘額，僅提供讀取（防止外部直接修改）
        public decimal Balance
        {
            get { return balance; }
        }
        public BankAccount(decimal initialBalance)
        {
            balance = initialBalance;
        }
        public void Deposit(decimal amount)
        {
            // 只接受正數的存款，若非正數則顯示訊息提示使用者
            if (amount > 0m)
            {
                balance += amount;
            }
            else
            {
                // 顯示錯誤訊息給使用者（繁體中文或英文皆可，這裡使用英文範例）
                MessageBox.Show("Deposit amount must be positive.", "Invalid Deposit", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }
        public void Withdraw(decimal amount)
        {
            // 只接受正數的提款，且不得超過目前餘額，若不合法則顯示訊息
            if (amount > 0m)
            {
                if (amount <= balance)
                {
                    balance -= amount;
                }
                else
                {
                    MessageBox.Show("Withdrawal amount cannot exceed the current balance.", "Invalid Withdrawal", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            else
            {
                MessageBox.Show("Withdrawal amount must be positive.", "Invalid Withdrawal", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }
        public decimal GetBalance()
        {
            return balance;
        }
    }
}
